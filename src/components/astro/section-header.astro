---
import { cn } from '@/lib/utils';
import type { ComponentProps } from 'react';

interface Props extends ComponentProps<"div"> {
    label: string;
    title: string;
    description?: string;
}

const { className, label, title, description } = Astro.props;

---

<div class={cn("flex flex-col gap-2", className)}>
    <div>
        <small>{label}</small>
        <h2>{title}</h2>
    </div>

    {description ? <p class="text-muted-foreground">{description}</p> : null}
</div>