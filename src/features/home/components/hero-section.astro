---
import Container from "@/components/astro/container.astro";
import { buttonVariants } from "@/components/ui/button";
import { NAME } from "@/config/constants";
import { ImageIcon, MailIcon } from "lucide-react";

---

<section id="home" class="min-h-svh flex">
    <Container className="grow flex flex-col gap-16 justify-center">
        <div class="flex flex-col gap-4">
            <div>
                <small>Hi, my name is</small>
                <h1>{NAME}.</h1>
            </div>
            <p class="lead">Software Engineer building functional web applications from scratch using TypeScript, React, and Node.js.</p>
        </div>

        <div class="flex gap-4">
            <a href="#projects" class={buttonVariants()}>
                <ImageIcon />
                <span>My Projects</span>
            </a>
            
            <a href="#contact" class={buttonVariants({ variant: "outline"})}>
                <MailIcon />
                <span>Contact Me</span>
            </a>
        </div>
    </Container>
</section>
